# Bluetooth
persist.bt.enable.splita2dp=false
persist.vendor.bt.enable.splita2dp=true
persist.vendor.bt.splita2dp.44_1_war=false
persist.vendor.btstack.a2dp_offload_cap=sbc-aptx-aptxhd-aac-ldac
persist.vendor.btstack.enable.splita2dp=true
persist.vendor.qcom.bluetooth.a2dp_offload_cap=sbc-aptx-aptxhd-aac-ldac
persist.vendor.qcom.bluetooth.enable.splita2dp=true
ro.bluetooth.emb_wp_mode=false
ro.bluetooth.wipower=false
ro.bt.bdaddr_path=/proc/bt_mac
ro.vendor.bluetooth.wipower=false
vendor.bluetooth.soc=cherokee
vendor.qcom.bluetooth.soc=cherokee

# CABL & Display
ro.vendor.display.cabl=2
vendor.display.disable_skip_validate=1
vendor.display.enable_default_color_mode=1
vendor.gralloc.enable_fb_ubwc=1

# Camera
camera.aux.packagelist=org.codeaurora.snapcam,com.android.camera,com.google.android.GoogleCamera
camera.disable_zsl_mode=0
camera.panorama.quality=middle
persist.vendor.camera.HAL3.enabled=1
persist.vendor.camera.eis.enable=1
persist.vendor.camera.exif.model=Nokia 6.1
persist.vendor.camera.fdvideo=1
persist.vendor.camera.preview.ubwc=0
persist.vendor.camera.privapp.list=org.codeaurora.snapcam,com.android.camera,com.google.android.GoogleCamera
persist.vendor.camera.stats.test=0
persist.vendor.camera.ven_hdr=0
ro.camera.record.anim.delay=200
ro.camera.switch.anim.delay=300
vendor.camera.aux.packagelist=org.codeaurora.snapcam,com.android.camera,com.google.android.GoogleCamera
vendor.camera.c2d.rotation=1

# CNE & DPM
persist.vendor.cne.feature=1
persist.vendor.dpm.feature=11

# DRM
drm.service.enabled=true
ro.com.widevine.cachesize=16777216

# FM
vendor.hw.fm.init=0

# FRP
ro.frp.pst=/dev/block/bootdevice/by-name/frp

# GL & Vulkan
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno
ro.opengles.version=196610

# GPS
persist.backup.ntpServer=0.pool.ntp.org
persist.vendor.overlay.izat.optin=rro

# Media & Video
vendor.mm.enable.qcom_parser=13623022
vendor.vidc.dec.enable.downscalar=0
vendor.vidc.enc.disable_bframes=1
vendor.video.disable.ubwc=1

# Miscellaneous
persist.vendor.qcomsysd.enabled=1
ro.cp_system_other_odex=1
sys.vendor.shutdown.waittime=500

# OEM Unlock
ro.oem_unlock_supported=1

# Perf
ro.vendor.extension_library=libqti-perfd-client.so

# Power
persist.env.fastdorm.enabled=true
persist.sys.screenmode=1
vendor.power.pasr.enabled=true

# Radio & Telephony
keyguard.no_require_sim=true
persist.vendor.data.mode=concurrent
persist.vendor.ims.disableADBLogs=1
persist.vendor.qti.telephony.vt_cam_interface=1
persist.vendor.radio.add_power_save=1
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.atfwd.start=true
persist.vendor.radio.cs_srv_type=1
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.data_ltd_sys_ind=1
persist.vendor.radio.lte_vrte_ltd=1
persist.vendor.radio.oem_socket=true
persist.vendor.radio.procedure_bytes=SKIP
persist.vendor.radio.rat_on=combine
persist.vendor.radio.report_codec=1
persist.vendor.radio.sib16_support=1
rild.libpath=/system/vendor/lib64/libril-qc-qmi-1.so
ro.carrier=unknown
ro.com.android.dataroaming=true
ro.telephony.iwlan_operation_mode=legacy
ro.vendor.qti.va_aosp.support=1
ro.vendor.use_data_netmgrd=true

# Sensors
ro.vendor.sdk.sensors.gestures=false
ro.vendor.sensors.cmc=false
ro.vendor.sensors.dev_ori=true
ro.vendor.sensors.facing=false
ro.vendor.sensors.mot_detect=true
ro.vendor.sensors.pmd=true
ro.vendor.sensors.sta_detect=true

# Stagefright
debug.stagefright.omx_default_rank.sw-audio=1
debug.stagefright.omx_default_rank=0

# Wi-Fi
ro.boot.wificountrycode=US
