<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings.device"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:label="@string/device_parts_name"
        android:persistent="true">

        <!-- Quick Settings Tile: Network Mode (4G / 3G / 2G) -->
        <service
            android:name=".NetworkModeTileService"
            android:icon="@drawable/ic_network_mode"
            android:label="@string/network_mode_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.SEM_DEFAULT_SETTING_ACTIVITY"
                android:value="org.lineageos.settings.device.NetworkSettingsActivity" />
        </service>

        <!-- Quick Settings Tile: Performance / Gaming & Battery Saver -->
        <service
            android:name=".PerformanceTileService"
            android:icon="@drawable/ic_performance_mode"
            android:label="@string/perf_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile: 720p / 1080p Resolution Switcher -->
        <service
            android:name=".ResolutionTileService"
            android:icon="@drawable/ic_resolution_mode"
            android:label="@string/resolution_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile: Bypass Charging (Feature 19) -->
        <service
            android:name=".BypassTileService"
            android:icon="@drawable/ic_bypass_charging"
            android:label="@string/bypass_charging_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile: Blaze Turbo Fast Charging -->
        <service
            android:name=".BlazeTileService"
            android:icon="@drawable/ic_blaze_turbo"
            android:label="@string/blaze_turbo_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Battery Care Service for dynamic broadcast monitoring -->
        <service
            android:name=".BatteryCareService"
            android:exported="false" />

        <!-- Broadcast Receiver for Boot, Power & Headset events -->
        <receiver
            android:name=".BatteryCareReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.HEADSET_PLUG" />
            </intent-filter>
        </receiver>

        <!-- Battery Protection & Blaze Engine Menu (Injected into Settings > Battery) -->
        <activity
            android:name=".BatteryProtectionActivity"
            android:label="@string/battery_protection_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/battery_care_summary" />
        </activity>

        <!-- Cellular & Band Controls Menu (Injected into Settings > Network & internet) -->
        <activity
            android:name=".NetworkSettingsActivity"
            android:label="@string/network_settings_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.wireless" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/network_settings_summary" />
        </activity>

        <!-- Device Extras: Display KCAL, Haptics & Audio Mod -->
        <activity
            android:name=".DeviceSettingsActivity"
            android:label="@string/device_extras_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/device_parts_name" />
        </activity>

    </application>
</manifest>
