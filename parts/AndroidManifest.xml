<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings.device"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="@string/device_parts_name"
        android:persistent="true">

        <!-- Quick Settings Tile: Bypass Charging (Feature 19) -->
        <service
            android:name=".BypassTileService"
            android:icon="@drawable/ic_bypass_charging"
            android:label="@string/bypass_charging_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile: Blaze Turbo Fast Charging -->
        <service
            android:name=".BlazeTileService"
            android:icon="@drawable/ic_blaze_turbo"
            android:label="@string/blaze_turbo_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Battery Care Service for dynamic broadcast monitoring -->
        <service
            android:name=".BatteryCareService"
            android:exported="false" />

        <!-- Broadcast Receiver for Boot & Power events (Feature 20 & 23) -->
        <receiver
            android:name=".BatteryCareReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Battery Protection & Blaze Engine Menu (Injected into Settings > Battery) -->
        <activity
            android:name=".BatteryProtectionActivity"
            android:label="@string/battery_protection_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/battery_care_summary" />
        </activity>

        <!-- Device Extras: Display KCAL, Haptics & Audio Mod -->
        <activity
            android:name=".DeviceSettingsActivity"
            android:label="@string/device_extras_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/device_parts_name" />
        </activity>

    </application>
</manifest>
