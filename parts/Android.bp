android_app {
    name: "DeviceParts",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    privileged: true,

    static_libs: [
        "androidx.core_core",
        "androidx.fragment_fragment",
        "androidx.preference_preference",
        "androidx.appcompat_appcompat",
    ],

    optimize: {
        enabled: false,
    },
}
